{
  "name": "better-feedly",
  "displayName": "Better Feedly",
  "version": "0.0.1",
  "description": "Feedlyへのフィードの登録、Feedlyの閲覧を効率的にする拡張機能です",
  "author": "fuchigta",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/chrome": "0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "happy-dom": "21.0.4",
    "prettier": "3.2.4",
    "typescript": "5.3.3",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*"
    ],
    "permissions": [
      "activeTab",
      "tabs",
      "scripting"
    ]
  }
}
